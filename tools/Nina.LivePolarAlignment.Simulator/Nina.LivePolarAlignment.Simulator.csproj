<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <PlatformTarget>x64</PlatformTarget>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <NinaInstallDirectory Condition="'$(NinaInstallDirectory)' == ''">$(ProgramFiles)\N.I.N.A. - Nighttime Imaging 'N' Astronomy</NinaInstallDirectory>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/Nina.LivePolarAlignment/Nina.LivePolarAlignment.csproj" />
    <Reference Include="NINA.WPF.Base"><HintPath>$(NinaInstallDirectory)\NINA.WPF.Base.dll</HintPath></Reference>
    <None Include="$(NinaInstallDirectory)\External\x64\SOFA\SOFAlib.dll" Link="External/x64/SOFA/SOFAlib.dll" CopyToOutputDirectory="PreserveNewest" />
    <None Include="$(NinaInstallDirectory)\External\x64\NOVAS\NOVAS31lib.dll" Link="External/x64/NOVAS/NOVAS31lib.dll" CopyToOutputDirectory="PreserveNewest" />
    <None Include="$(NinaInstallDirectory)\SQLite.Interop.dll" Link="SQLite.Interop.dll" CopyToOutputDirectory="PreserveNewest" />
    <None Include="$(NinaInstallDirectory)\External\x64\FreeImage\FreeImage.dll" Link="External/x64/FreeImage/FreeImage.dll" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
