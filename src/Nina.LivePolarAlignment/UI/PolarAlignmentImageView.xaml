<UserControl x:Class="Nina.LivePolarAlignment.UI.PolarAlignmentImageView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ns="clr-namespace:NINA.Core.Locale;assembly=NINA.Core" xmlns:local="clr-namespace:Nina.LivePolarAlignment.UI" MinWidth="220" Background="{DynamicResource BackgroundBrush}" Foreground="{DynamicResource PrimaryBrush}">
<UserControl.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="/Nina.LivePolarAlignment;component/UI/PolarAlignmentStyles.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary></UserControl.Resources>
<Border x:Name="ImagePanel" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="3"><DockPanel LastChildFill="True">
<WrapPanel x:Name="ImageToolbar" DockPanel.Dock="Top" Margin="3,0,3,3" VerticalAlignment="Center">
 <StackPanel Orientation="Horizontal" Height="30" ToolTip="{local:UiLoc StretchHint}" Margin="0,0,8,0">
  <TextBlock Text="{local:UiLoc Stretch}" FontSize="11" VerticalAlignment="Center" Margin="0,0,5,0"/>
  <ToggleButton Style="{StaticResource AlignmentSwitch}" IsChecked="{Binding PreviewStretchEnabled}" Margin="0,0,7,0"/>
  <Slider x:Name="CompactStretchSlider" Width="140" IsEnabled="{Binding PreviewStretchEnabled}" Minimum="0.25" Maximum="2.5" SmallChange="0.05" LargeChange="0.25" TickFrequency="0.05" IsSnapToTickEnabled="True" IsMoveToPointEnabled="True" Value="{Binding PreviewStretchStrength, Mode=TwoWay}" VerticalAlignment="Center" AutomationProperties.Name="{local:UiLoc Stretch}"/>
  <TextBlock Text="{Binding PreviewStretchText}" Width="39" FontSize="11" TextAlignment="Right" VerticalAlignment="Center" Margin="4,0"/>
  <Button Command="{Binding ResetPreviewStretchCommand}" Style="{StaticResource AlignmentButton}" Content="↺" ToolTip="{local:UiLoc ResetStretch}" Width="28" Padding="3"/>
 </StackPanel>
 <StackPanel Orientation="Horizontal" Height="30"><TextBlock Text="{local:UiLoc Focus}" FontSize="11" VerticalAlignment="Center" Margin="0,0,5,0"/><ToggleButton Style="{StaticResource AlignmentSwitch}" ToolTip="{local:UiLoc FocusTip}" IsChecked="{Binding FocusImage, Mode=TwoWay}"/></StackPanel>
</WrapPanel>
   <Grid>
    <local:PolarFieldView x:Name="SkyField" FocusAlignment="{Binding FocusImage, Mode=TwoWay}" PolarisCandidate="{Binding PolarisCandidate}" Stars="{Binding DisplayStars}" AreStarsFresh="{Binding HasFreshStars}" IsDriftView="{Binding IndependentDriftEnabled}" Preview="{Binding LivePreview}" UsePolarisTarget="{Binding UsePolarisTarget}" IsPoleMasterMonitoring="{Binding IsPoleMasterMonitoring}" Guidance="{Binding FieldGuidance}" IsCurrent="{Binding HasDisplayGuidance}" IsGuidanceFresh="{Binding HasCurrentFieldGuidance}" PixelScale="{Binding PixelScaleArcseconds}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
     <StackPanel x:Name="EmptyImagePlaceholder" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
      <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding HasPreview}" Value="False"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></StackPanel.Style>
      <Path Data="{DynamicResource PictureSVG}" Width="100" Height="100" Margin="5" Stretch="Uniform" Fill="{DynamicResource ButtonForegroundDisabledBrush}" Opacity="0.4" UseLayoutRounding="True"/>
      <TextBlock Text="{ns:Loc LblNoImage}" HorizontalAlignment="Center" Foreground="{DynamicResource ButtonForegroundDisabledBrush}" Margin="0,8,0,0"/>
     </StackPanel>
    </Grid>

</DockPanel></Border></UserControl>