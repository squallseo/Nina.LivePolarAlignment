<UserControl x:Class="Nina.LivePolarAlignment.UI.PolarAlignmentView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:ns="clr-namespace:NINA.Core.Locale;assembly=NINA.Core"
 xmlns:local="clr-namespace:Nina.LivePolarAlignment.UI"
 MinWidth="320" Background="{DynamicResource BackgroundBrush}" Foreground="{DynamicResource PrimaryBrush}" FontFamily="Segoe UI" FontSize="12">
 <UserControl.Resources>
      <Style x:Key="AlignmentButton" TargetType="Button">
        <Setter Property="FontSize" Value="12"/><Setter Property="FontWeight" Value="Normal"/><Setter Property="MinHeight" Value="28" />
        <Setter Property="Padding" Value="9,3" />
        <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}" />
        <Setter Property="Background" Value="{DynamicResource ButtonBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="Button">
              <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5" Padding="{TemplateBinding Padding}">
                <ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" TextElement.Foreground="{TemplateBinding Foreground}" HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="Surface" Property="Background" Value="{DynamicResource ButtonBackgroundSelectedBrush}" />
                  <Setter Property="Foreground" Value="{DynamicResource ButtonForegroundBrush}" />
                </Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True">
                  <Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource SecondaryBrush}" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                  <Setter TargetName="Surface" Property="Background" Value="{DynamicResource ButtonBackgroundBrush}" />
                  <Setter Property="Foreground" Value="{DynamicResource ButtonForegroundBrush}" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                  <Setter TargetName="Surface" Property="Opacity" Value="0.4" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="AlignmentSwitch" TargetType="ToggleButton">
        <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="ToggleButton">
              <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}" VerticalAlignment="Center" Margin="0,0,6,0" FontSize="11" />
                <Border x:Name="Track" Width="30" Height="16" CornerRadius="8" Background="{DynamicResource ButtonBackgroundBrush}" BorderBrush="{DynamicResource SecondaryBrush}" BorderThickness="1">
                  <Ellipse x:Name="Thumb" Width="10" Height="10" Fill="{DynamicResource PrimaryBrush}" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="2,0" />
                </Border>
              </StackPanel>
              <ControlTemplate.Triggers>
                <Trigger Property="IsChecked" Value="True">
                  <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right" />
                  <Setter TargetName="Track" Property="Background" Value="{DynamicResource SecondaryBrush}" />
                  <Setter TargetName="Thumb" Property="Fill" Value="{DynamicResource BackgroundBrush}" />
                </Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True">
                  <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                  <Setter Property="Opacity" Value="0.4" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style TargetType="TextBox">
        <Setter Property="Background" Value="{DynamicResource BackgroundBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="MinHeight" Value="28" />
        <Setter Property="CaretBrush" Value="{DynamicResource PrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
        <Setter Property="Padding" Value="6,3" />
      </Style>

<Style TargetType="TextBlock" BasedOn="{StaticResource StandardTextBlock}"><Setter Property="TextWrapping" Value="Wrap"/></Style><BooleanToVisibilityConverter x:Key="VisibleIf"/><Style x:Key="Caption" TargetType="TextBlock" BasedOn="{StaticResource StandardTextBlock}"><Setter Property="Foreground" Value="{DynamicResource SecondaryBrush}"/><Setter Property="FontSize" Value="11"/><Setter Property="TextWrapping" Value="Wrap"/></Style><Style x:Key="StepCard" TargetType="Border"><Setter Property="Padding" Value="4"/></Style></UserControl.Resources>
 <Grid x:Name="WorkspaceGrid" Margin="4">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition x:Name="ImageRow" Height="*"/><RowDefinition x:Name="NarrowControlsRow" Height="0"/></Grid.RowDefinitions>
  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition x:Name="DividerColumn" Width="6"/><ColumnDefinition x:Name="ControlsColumn" Width="290" MinWidth="270" MaxWidth="480"/></Grid.ColumnDefinitions>
  <Border x:Name="ImagePanel" Grid.Row="1" Grid.Column="0" Background="{DynamicResource BackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="1" Padding="5">
   <DockPanel LastChildFill="True">
    <Grid DockPanel.Dock="Top" Margin="3,0,3,8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{ns:Loc LblImage}" Foreground="{DynamicResource PrimaryBrush}" FontWeight="SemiBold"/><StackPanel Grid.Column="1" Orientation="Horizontal"><TextBlock Text="{local:UiLoc Focus}" VerticalAlignment="Center" Margin="0,0,6,0"/><ToggleButton Style="{StaticResource AlignmentSwitch}" ToolTip="{local:UiLoc FocusTip}" IsChecked="{Binding FocusAlignment, ElementName=SkyField}"/></StackPanel></Grid>
    <Grid>
     <local:PolarFieldView x:Name="SkyField" IsDriftView="{Binding IndependentDriftEnabled}" Preview="{Binding LivePreview}" Guidance="{Binding FieldGuidance}" IsCurrent="{Binding HasCurrentFieldGuidance}" PixelScale="{Binding PixelScaleArcseconds}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
     <StackPanel x:Name="EmptyImagePlaceholder" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
      <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding HasPreview}" Value="False"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></StackPanel.Style>
      <Path Data="{DynamicResource PictureSVG}" Width="100" Height="100" Margin="5" Stretch="Uniform" Fill="{DynamicResource ButtonForegroundDisabledBrush}" Opacity="0.4" UseLayoutRounding="True"/>
      <TextBlock Text="{ns:Loc LblNoImage}" HorizontalAlignment="Center" Foreground="{DynamicResource ButtonForegroundDisabledBrush}" Margin="0,8,0,0"/>
     </StackPanel>
    </Grid>
   </DockPanel>
  </Border>
  <GridSplitter x:Name="PanelDivider" Grid.Row="1" Grid.Column="1" Width="5" HorizontalAlignment="Center" VerticalAlignment="Stretch" Background="{DynamicResource BorderBrush}" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" ShowsPreview="True" ToolTip="{local:UiLoc View0}"/>
  <ScrollViewer x:Name="ControlScroll" Grid.Row="1" Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
   <StackPanel Margin="0,0,2,0">

   <StackPanel Margin="2,0,2,8">
    <TextBlock Text="{Binding WorkflowTitle}" FontWeight="SemiBold"/>
    <TextBlock Text="{Binding WorkflowDescription}" Style="{StaticResource Caption}" Margin="0,4,0,0" ToolTip="{Binding WorkflowHelp}"/>
   </StackPanel>

   <StackPanel Margin="0,0,0,8" Visibility="{Binding IsPolarView, Converter={StaticResource VisibleIf}}">
    <DockPanel ToolTip="{Binding RotationStatus}" ToolTipService.ShowOnDisabled="True"><TextBlock Text="{local:UiLoc AutoRaOption}" VerticalAlignment="Center"/><ToggleButton Style="{StaticResource AlignmentSwitch}" HorizontalAlignment="Right" IsChecked="{Binding AutoRaRotation}" IsEnabled="{Binding CanUseAutoRotation}"/></DockPanel>
    <StackPanel Visibility="{Binding AutoRaRotation, Converter={StaticResource VisibleIf}}">
     <DockPanel Margin="0,5,0,0"><ComboBox DockPanel.Dock="Right" Width="72" ItemsSource="{Binding RotationAngleChoices}" SelectedItem="{Binding RotationAngleDegrees}" IsEnabled="{Binding CanConfigureRotation}"/><TextBlock Text="{local:UiLoc AutoRaAngle}" Style="{StaticResource Caption}" VerticalAlignment="Center"/></DockPanel>

     <DockPanel Margin="0,4,0,0"><ToggleButton DockPanel.Dock="Right" Style="{StaticResource AlignmentSwitch}" IsChecked="{Binding ReverseRaRotation}" IsEnabled="{Binding CanConfigureRotation}"/><TextBlock Text="{local:UiLoc AutoRaReverse}" Style="{StaticResource Caption}" VerticalAlignment="Center"/></DockPanel>
     <DockPanel Margin="0,4,0,0"><ToggleButton DockPanel.Dock="Right" Style="{StaticResource AlignmentSwitch}" IsChecked="{Binding RotationPathClear}" IsEnabled="{Binding CanConfigureRotation}"/><TextBlock Text="{Binding RotationPathLabel}" Style="{StaticResource Caption}" VerticalAlignment="Center"/></DockPanel>

    </StackPanel>
   </StackPanel>
   <StackPanel Margin="0,0,0,8" Visibility="{Binding IsPolarView, Converter={StaticResource VisibleIf}}" ToolTip="{Binding StreamingAvailability}" ToolTipService.ShowOnDisabled="True">
    <DockPanel><TextBlock Text="{local:UiLoc StreamingOption}" VerticalAlignment="Center"/><ToggleButton Style="{StaticResource AlignmentSwitch}" DockPanel.Dock="Right" HorizontalAlignment="Right" IsChecked="{Binding UseStreaming}" IsEnabled="{Binding CanUseStreaming}" ToolTip="{Binding StreamingAvailability}"/></DockPanel>
   </StackPanel>
   <Grid Margin="0,0,0,13">
    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <TextBlock Text="{ns:Loc LblExposureTime}" VerticalAlignment="Center" Margin="0,0,8,0"/>
    <TextBox Grid.Column="1" Width="60" Text="{Binding ExposureSeconds, UpdateSourceTrigger=LostFocus}" IsEnabled="{Binding CanConfigureLive}" AutomationProperties.Name="{local:UiLoc View7}"/>
    <TextBlock Grid.Column="2" Text="{local:UiLoc View8}" VerticalAlignment="Center" Foreground="{DynamicResource PrimaryBrush}" Margin="7,0,0,0"/>
   </Grid>

   <Grid Margin="0,0,0,10">
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <Button Style="{StaticResource AlignmentButton}" Content="{Binding PrimaryActionLabel}" Command="{Binding PrimaryActionCommand}" Margin="0,0,8,0"/>
    <Button Style="{StaticResource AlignmentButton}" Grid.Column="1" Content="{ns:Loc LblStop}" Command="{Binding StopLiveCommand}" Margin="0,0,8,0"/>
    <Button Style="{StaticResource AlignmentButton}" Grid.Column="2" Content="{local:UiLoc View5}" ToolTip="{local:UiLoc View6}" Command="{Binding ResetLiveCommand}"/>
   </Grid>
   <Border Background="{DynamicResource BackgroundBrush}" BorderBrush="{DynamicResource NotificationErrorTextBrush}" BorderThickness="1" CornerRadius="1" Padding="5" Margin="0,0,0,12" Visibility="{Binding HasOperationError, Converter={StaticResource VisibleIf}}"><StackPanel><TextBlock Text="{local:UiLoc View9}" Foreground="{DynamicResource PrimaryBrush}" FontWeight="SemiBold"/><TextBlock Text="{Binding OperationError}" Foreground="{DynamicResource PrimaryBrush}" Margin="0,5,0,0"/></StackPanel></Border>

   <Border Background="{DynamicResource BackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="1" Padding="5" Visibility="{Binding IsPolarView, Converter={StaticResource VisibleIf}}">
    <StackPanel>
     <Grid Margin="0,0,0,6"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{local:UiLoc View10}" Style="{StaticResource Caption}"/><TextBlock Grid.Column="1" Text="{Binding MeasurementState}" FontSize="10" Foreground="{DynamicResource ButtonBackgroundSelectedBrush}"/></Grid>
     <TextBlock Text="{Binding LiveTotalError}" FontSize="26" FontWeight="SemiBold" Margin="0,0,0,5">
      <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}"/><Style.Triggers><DataTrigger Binding="{Binding IsMeasurementStale}" Value="True"><Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}"/></DataTrigger><DataTrigger Binding="{Binding IsWithinTarget}" Value="True"><Setter Property="Foreground" Value="{DynamicResource ButtonBackgroundSelectedBrush}"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
     </TextBlock>
     <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Border Background="{DynamicResource BackgroundBrush}" CornerRadius="1" Padding="5" Margin="0,0,5,0"><StackPanel><TextBlock Text="{ns:Loc LblAltitude}" Style="{StaticResource Caption}"/><TextBlock Text="{Binding AltitudeValue}" FontSize="18" Margin="0,5,0,4"/><TextBlock Text="{Binding AltitudeAction}" Style="{StaticResource Caption}" ToolTip="{local:UiLoc View11}"/></StackPanel></Border>
      <Border Grid.Column="1" Background="{DynamicResource BackgroundBrush}" CornerRadius="1" Padding="5" Margin="5,0,0,0"><StackPanel><TextBlock Text="{ns:Loc LblAzimuth}" Style="{StaticResource Caption}"/><TextBlock Text="{Binding AzimuthValue}" FontSize="18" Margin="0,5,0,4"/><TextBlock Text="{Binding AzimuthAction}" Style="{StaticResource Caption}" ToolTip="{local:UiLoc View11}"/></StackPanel></Border>
     </Grid>
     <StackPanel x:Name="AlignmentDetailPanel" Visibility="{Binding HasAlignmentDetail, Converter={StaticResource VisibleIf}}" Margin="0,8,0,0">
      <TextBlock Text="{local:UiLoc AlignmentCloseUp}" Style="{StaticResource Caption}" Margin="0,0,0,4"/>
      <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="5" ClipToBounds="True">
       <local:PolarFieldView x:Name="AlignmentDetailView" Height="186" DetailMode="True" ReferenceScale="{Binding ImageScale, ElementName=SkyField}" Preview="{Binding LivePreview}" Guidance="{Binding FieldGuidance}" IsCurrent="{Binding HasCurrentFieldGuidance}" PixelScale="{Binding PixelScaleArcseconds}"/>
      </Border>
     </StackPanel>
     <TextBlock Text="{Binding FrameFreshness}" Style="{StaticResource Caption}" Margin="0,11,0,0"/>
    </StackPanel>
   </Border>
   <TextBlock Text="{Binding LiveStatus}" Style="{StaticResource Caption}" Margin="2,6,2,6"/>

   <Expander x:Name="VerificationTools" Header="{local:UiLoc VerificationTitle}" Foreground="{DynamicResource PrimaryBrush}" Margin="0,6,0,0" Visibility="{Binding ShowVerification, Converter={StaticResource VisibleIf}}">
    <StackPanel Margin="2,6,2,0">
     <TextBlock Text="{Binding VerificationSummary}" Style="{StaticResource Caption}"/>
     <DockPanel Margin="0,5,0,0"><ComboBox DockPanel.Dock="Right" Width="72" ItemsSource="{Binding RotationAngleChoices}" SelectedItem="{Binding RotationAngleDegrees}" IsEnabled="{Binding CanConfigureVerification}"/><TextBlock Text="{local:UiLoc AutoRaAngle}" Style="{StaticResource Caption}" VerticalAlignment="Center"/></DockPanel>
     <DockPanel Margin="0,5,0,0"><ToggleButton DockPanel.Dock="Right" Style="{StaticResource AlignmentSwitch}" IsChecked="{Binding VerificationReverse}" IsEnabled="{Binding CanConfigureVerification}"/><TextBlock Text="{local:UiLoc AutoRaReverse}" Style="{StaticResource Caption}"/></DockPanel>
     <DockPanel Margin="0,5,0,0"><ToggleButton DockPanel.Dock="Right" Style="{StaticResource AlignmentSwitch}" IsChecked="{Binding VerificationPathClear}" IsEnabled="{Binding CanConfigureVerification}"/><TextBlock Text="{Binding RotationPathLabel}" Style="{StaticResource Caption}"/></DockPanel>
     <DockPanel Margin="0,5,0,0"><ToggleButton DockPanel.Dock="Right" Style="{StaticResource AlignmentSwitch}" IsChecked="{Binding AutoVerificationStability}" IsEnabled="{Binding CanConfigureVerification}"/><TextBlock Text="{local:UiLoc VerificationStability}" Style="{StaticResource Caption}"/></DockPanel>
     <Button Content="{local:UiLoc VerificationStart}" Command="{Binding VerifyAlignmentCommand}" Style="{StaticResource AlignmentButton}" Margin="0,7,0,0" ToolTip="{local:UiLoc VerificationHint}"/>
     <TextBlock Text="{Binding StabilityStatus}" Style="{StaticResource Caption}" Margin="0,5,0,0"/>
    </StackPanel>
   </Expander>
   <Expander x:Name="IndependentDriftTools" Header="{local:UiLoc DriftTitle}" Foreground="{DynamicResource PrimaryBrush}" Margin="0,6,0,0">
    <StackPanel Margin="2,6,2,0">
     <DockPanel><ToggleButton DockPanel.Dock="Right" Style="{StaticResource AlignmentSwitch}" IsChecked="{Binding IndependentDriftEnabled}" IsEnabled="{Binding CanConfigureDrift}"/><TextBlock Text="{local:UiLoc DriftEnable}" Style="{StaticResource Caption}"/></DockPanel>
     <StackPanel Visibility="{Binding IndependentDriftEnabled, Converter={StaticResource VisibleIf}}">
      <DockPanel Margin="0,5,0,0"><TextBlock Text="{local:UiLoc DriftDuration}" Style="{StaticResource Caption}"/><TextBox Width="50" Text="{Binding DriftDurationSeconds, UpdateSourceTrigger=LostFocus}" IsEnabled="{Binding CanConfigureDrift}" Margin="5,0,0,0"/></DockPanel>

      <DockPanel Margin="0,5,0,0"><ToggleButton DockPanel.Dock="Right" Style="{StaticResource AlignmentSwitch}" IsChecked="{Binding DriftConfirmed}" IsEnabled="{Binding CanConfigureDrift}"/><TextBlock Text="{local:UiLoc DriftConfirm}" Style="{StaticResource Caption}"/></DockPanel>
      <Button Content="{Binding DriftActionLabel}" Command="{Binding IndependentDriftCommand}" Style="{StaticResource AlignmentButton}" Margin="0,6,0,0"/>
      <Button Content="{local:UiLoc DriftReset}" Command="{Binding ResetIndependentDriftCommand}" Style="{StaticResource AlignmentButton}" Margin="0,4,0,0"/>
      <TextBlock Text="{Binding IndependentDriftStatus}" Style="{StaticResource Caption}" Margin="0,6,0,0"/>
     </StackPanel>
    </StackPanel>
   </Expander>
   <Border Background="{DynamicResource BackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="5" Margin="0,7,0,0" Visibility="{Binding ShowAlignmentAssessment, Converter={StaticResource VisibleIf}}">
    <StackPanel>
     <DockPanel><TextBlock Text="{local:UiLoc ValidationTarget}" Style="{StaticResource Caption}"/><TextBox Width="45" Text="{Binding ValidationTargetArcseconds, UpdateSourceTrigger=LostFocus}" IsEnabled="{Binding CanConfigureDrift}" Margin="5,0,0,0"/></DockPanel>
     <TextBlock Text="{Binding AlignmentAssessmentText}" TextWrapping="Wrap" FontSize="11" Margin="0,5,0,0"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource SecondaryBrush}"/><Style.Triggers><DataTrigger Binding="{Binding HasValidationWarning}" Value="True"><Setter Property="Foreground" Value="{DynamicResource NotificationWarningTextBrush}"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
    </StackPanel>
   </Border>
   <Expander x:Name="FieldValidationTools" Header="{local:UiLoc FieldValidation}" Foreground="{DynamicResource PrimaryBrush}" Margin="0,6,0,0">
    <StackPanel Margin="2,6,2,0">
     <DockPanel><TextBlock Text="{local:UiLoc FieldRecord}" VerticalAlignment="Center"/><ToggleButton Style="{StaticResource AlignmentSwitch}" HorizontalAlignment="Right" IsChecked="{Binding RecordFieldSession}" IsEnabled="{Binding CanConfigureField}" ToolTip="{local:UiLoc FieldRecordHint}"/></DockPanel>
     <TextBox Text="{Binding FieldNote, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{local:UiLoc FieldNotes}" ToolTip="{local:UiLoc FieldNotesHint}" Margin="0,6,0,4"/>
     <WrapPanel><Button Content="{local:UiLoc FieldMark}" Command="{Binding MarkFieldSampleCommand}" Style="{StaticResource AlignmentButton}" Margin="0,0,4,0" ToolTip="{local:UiLoc FieldMarkHint}"/><Button Content="{local:UiLoc FieldStability}" Command="{Binding CheckStabilityCommand}" Style="{StaticResource AlignmentButton}" Margin="0,0,4,0"/><Button Content="{local:UiLoc FieldFolder}" Command="{Binding OpenFieldFolderCommand}" Style="{StaticResource AlignmentButton}"/></WrapPanel>
     <TextBlock Text="{Binding StabilityStatus}" Style="{StaticResource Caption}" Margin="0,5,0,0"/>
    </StackPanel>
   </Expander>
   <TextBlock Text="{Binding FieldRecordingStatus}" Margin="2,4,2,0" ToolTip="{Binding FieldSessionDirectory}"><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource Caption}"><Style.Triggers><DataTrigger Binding="{Binding HasFieldFailure}" Value="True"><Setter Property="Foreground" Value="{DynamicResource NotificationWarningTextBrush}"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
</StackPanel></ScrollViewer></Grid></UserControl>
