<UserControl x:Class="Nina.LivePolarAlignment.UI.PolarAlignmentView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="clr-namespace:Nina.LivePolarAlignment.UI"
 MinWidth="320" Background="#0C1421" Foreground="#EAF0F8" FontFamily="Segoe UI" FontSize="12">
 <UserControl.Resources>
  <BooleanToVisibilityConverter x:Key="VisibleIf"/>
  <Style TargetType="ScrollBar">
   <Setter Property="Width" Value="8"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar">
    <Grid Background="#0C1421">
     <Track x:Name="PART_Track" IsDirectionReversed="True" Orientation="Vertical">
      <Track.DecreaseRepeatButton><RepeatButton Command="ScrollBar.PageUpCommand" Focusable="False"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.DecreaseRepeatButton>
      <Track.Thumb><Thumb><Thumb.Template><ControlTemplate TargetType="Thumb"><Border Background="#30465E" CornerRadius="3" Margin="2,3"/></ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
      <Track.IncreaseRepeatButton><RepeatButton Command="ScrollBar.PageDownCommand" Focusable="False"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.IncreaseRepeatButton>
     </Track>
    </Grid>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style>
  <Style x:Key="Caption" TargetType="TextBlock"><Setter Property="Foreground" Value="#8D9DB4"/><Setter Property="FontSize" Value="11"/></Style>
  <Style TargetType="Button">
   <Setter Property="Background" Value="#1A293D"/><Setter Property="Foreground" Value="#D4DEED"/>
   <Setter Property="BorderBrush" Value="#2A3B53"/><Setter Property="BorderThickness" Value="1"/>
   <Setter Property="Padding" Value="14,11"/><Setter Property="FontWeight" Value="SemiBold"/>
   <Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
     <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
    </Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Opacity" Value="0.83"/></Trigger>
     <Trigger Property="IsPressed" Value="True"><Setter TargetName="Chrome" Property="Opacity" Value="0.65"/></Trigger>
     <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="#F0BA72"/><Setter TargetName="Chrome" Property="BorderThickness" Value="2"/></Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Chrome" Property="Opacity" Value="0.35"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="TextBox">
   <Setter Property="Background" Value="#0D1726"/><Setter Property="Foreground" Value="#EAF0F8"/>
   <Setter Property="BorderBrush" Value="#30435D"/><Setter Property="Padding" Value="9,6"/>
   <Setter Property="VerticalContentAlignment" Value="Center"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox"><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="6"><ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/></Border></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="StepCard" TargetType="Border">
   <Setter Property="Background" Value="#111D2D"/><Setter Property="BorderBrush" Value="#213047"/>
   <Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="8"/><Setter Property="Padding" Value="10,9"/>
  </Style>
 </UserControl.Resources>
 <Grid x:Name="WorkspaceGrid" Margin="14">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition x:Name="ImageRow" Height="*"/><RowDefinition x:Name="NarrowControlsRow" Height="0"/></Grid.RowDefinitions>
  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition x:Name="DividerColumn" Width="12"/><ColumnDefinition x:Name="ControlsColumn" Width="350" MinWidth="300" MaxWidth="480"/></Grid.ColumnDefinitions>
   <Grid Grid.Row="0" Grid.ColumnSpan="3" Margin="0,0,0,12">
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel Orientation="Horizontal"><TextBlock Text="극축 정렬" FontSize="23" FontWeight="SemiBold"/><TextBlock Text="LIVE POLAR ALIGNMENT" FontSize="10" Foreground="#68DEC5" VerticalAlignment="Center" Margin="14,0,0,0"/></StackPanel>
    <Border Grid.Column="1" Background="#17283A" CornerRadius="12" Padding="9,4" VerticalAlignment="Top"><TextBlock Text="실험 버전" FontSize="10" Foreground="#9EB3CD"/></Border>
   </Grid>

  <Border x:Name="ImagePanel" Grid.Row="1" Grid.Column="0" Background="#080F1B" BorderBrush="#263750" BorderThickness="1" CornerRadius="12" Padding="10">
   <DockPanel LastChildFill="True">
    <Grid DockPanel.Dock="Top" Margin="3,0,3,8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="하늘 영상" Foreground="#BACBDE" FontWeight="SemiBold"/><TextBlock Grid.Column="1" Text="{Binding MeasurementState}" FontSize="10" Foreground="#68DEC5"/></Grid>
    <StackPanel DockPanel.Dock="Bottom" Margin="3,8,3,0">
     <WrapPanel><TextBlock Text="⊕ RA 회전 중심" Foreground="#F0BA72" FontSize="11" Margin="0,0,16,3"/><TextBlock Text="◎ 천구극 · 목표" Foreground="#68DEC5" FontSize="11"/></WrapPanel>
     <TextBlock Text="천구극은 북극성과 다른 지점입니다. 점선 원은 천구극 주변의 각거리 눈금입니다." Style="{StaticResource Caption}"/>
    </StackPanel>
    <local:PolarFieldView x:Name="SkyField" Preview="{Binding LivePreview}" Guidance="{Binding FieldGuidance}" IsCurrent="{Binding HasCurrentFieldGuidance}" PixelScale="{Binding PixelScaleArcseconds}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
   </DockPanel>
  </Border>
  <GridSplitter x:Name="PanelDivider" Grid.Row="1" Grid.Column="1" Width="5" HorizontalAlignment="Center" VerticalAlignment="Stretch" Background="#203147" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" ShowsPreview="True" ToolTip="영상과 조작 패널 너비 조절"/>
  <ScrollViewer x:Name="ControlScroll" Grid.Row="1" Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
   <StackPanel Margin="0,0,2,0">

   <Grid Margin="0,0,0,14">
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border Margin="0,0,5,0">
     <Border.Style><Style TargetType="Border" BasedOn="{StaticResource StepCard}"><Style.Triggers><DataTrigger Binding="{Binding WorkflowStep}" Value="0"><Setter Property="Background" Value="#15372F"/><Setter Property="BorderBrush" Value="#4DBCA4"/></DataTrigger></Style.Triggers></Style></Border.Style>
     <StackPanel><TextBlock Text="01" Foreground="#68DEC5" FontSize="10"/><TextBlock Text="기준 촬영" FontWeight="SemiBold" Margin="0,4,0,0"/></StackPanel>
    </Border>
    <Border Grid.Column="1" Margin="3,0,3,0">
     <Border.Style><Style TargetType="Border" BasedOn="{StaticResource StepCard}"><Style.Triggers><DataTrigger Binding="{Binding WorkflowStep}" Value="1"><Setter Property="Background" Value="#15372F"/><Setter Property="BorderBrush" Value="#4DBCA4"/></DataTrigger></Style.Triggers></Style></Border.Style>
     <StackPanel><TextBlock Text="02" Foreground="#68DEC5" FontSize="10"/><TextBlock Text="RA 회전" FontWeight="SemiBold" Margin="0,4,0,0"/></StackPanel>
    </Border>
    <Border Grid.Column="2" Margin="5,0,0,0">
     <Border.Style><Style TargetType="Border" BasedOn="{StaticResource StepCard}"><Style.Triggers><DataTrigger Binding="{Binding WorkflowStep}" Value="2"><Setter Property="Background" Value="#15372F"/><Setter Property="BorderBrush" Value="#4DBCA4"/></DataTrigger></Style.Triggers></Style></Border.Style>
     <StackPanel><TextBlock Text="03" Foreground="#68DEC5" FontSize="10"/><TextBlock Text="볼트 조정" FontWeight="SemiBold" Margin="0,4,0,0"/></StackPanel>
    </Border>
   </Grid>

   <Border Background="#142238" BorderBrush="#253850" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,14">
    <StackPanel>
     <TextBlock Text="{Binding WorkflowTitle}" FontSize="15" FontWeight="SemiBold"/>
     <TextBlock Text="{Binding WorkflowDescription}" Foreground="#AEBED2" LineHeight="19" Margin="0,7,0,0"/>
     <TextBlock Text="{Binding RotationReadout}" Foreground="#68DEC5" FontSize="11" Margin="0,8,0,0" Visibility="{Binding IsAdjustmentStep, Converter={StaticResource VisibleIf}}"/>
     <Grid Margin="0,12,0,0" Visibility="{Binding IsRotationStep, Converter={StaticResource VisibleIf}}">
      <Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Viewbox Width="76" Height="76" HorizontalAlignment="Left">
       <Canvas Width="80" Height="80">
        <Ellipse Width="58" Height="58" Canvas.Left="11" Canvas.Top="11" Stroke="#304D65" StrokeThickness="1"/>
        <Line X1="40" Y1="40" X2="40" Y2="8" Stroke="#5D7E96" StrokeThickness="2" StrokeDashArray="2,2"/>
        <Line X1="40" Y1="40" X2="72" Y2="40" Stroke="#68DEC5" StrokeThickness="2"/>
        <Path Data="M40,8 A32,32 0 0 1 72,40 M65,34 L72,40 L77,32" Stroke="#68DEC5" StrokeThickness="2"/>
        <Ellipse Width="6" Height="6" Canvas.Left="37" Canvas.Top="37" Fill="#F0BA72"/>
        <TextBlock Text="RA" Canvas.Left="22" Canvas.Top="47" FontSize="12" Foreground="#D8E5F2"/>
       </Canvas>
      </Viewbox>
      <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="{Binding RotationReadout}" Foreground="#68DEC5" FontWeight="SemiBold"/><TextBlock Text="권장 각도 그림입니다. 실제 회전량은 촬영 후 계산됩니다." Style="{StaticResource Caption}" Margin="0,5,0,0"/></StackPanel>
     </Grid>
    </StackPanel>
   </Border>

   <Grid Margin="0,0,0,10">
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <Button Content="{Binding PrimaryActionLabel}" Command="{Binding PrimaryActionCommand}" Background="#68DEC5" Foreground="#08271F" BorderBrush="#68DEC5" Margin="0,0,8,0"/>
    <Button Grid.Column="1" Content="중지" Command="{Binding StopLiveCommand}" Margin="0,0,8,0"/>
    <Button Grid.Column="2" Content="다시" ToolTip="기준을 초기화하고 처음부터 시작합니다" Command="{Binding ResetLiveCommand}" Padding="11,11"/>
   </Grid>
   <Grid Margin="0,0,0,13">
    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <TextBlock Text="노출" VerticalAlignment="Center" Foreground="#8D9DB4" Margin="0,0,8,0"/>
    <TextBox Grid.Column="1" Width="60" Text="{Binding ExposureSeconds, UpdateSourceTrigger=LostFocus}" IsEnabled="{Binding CanConfigureLive}" AutomationProperties.Name="노출 시간(초)"/>
    <TextBlock Grid.Column="2" Text="초" VerticalAlignment="Center" Foreground="#8D9DB4" Margin="7,0,0,0"/>
   </Grid>

   <Border Background="#382A1D" BorderBrush="#825E36" BorderThickness="1" CornerRadius="8" Padding="11" Margin="0,0,0,12" Visibility="{Binding HasOperationError, Converter={StaticResource VisibleIf}}"><StackPanel><TextBlock Text="확인이 필요합니다" Foreground="#F0BA72" FontWeight="SemiBold"/><TextBlock Text="{Binding OperationError}" Foreground="#DECBB1" Margin="0,5,0,0"/></StackPanel></Border>

   <Border Background="#101C2D" BorderBrush="#263750" BorderThickness="1" CornerRadius="12" Padding="14">
    <StackPanel>
     <Grid Margin="0,0,0,6"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="전체 극축 오차" Style="{StaticResource Caption}"/><TextBlock Grid.Column="1" Text="{Binding MeasurementState}" FontSize="10" Foreground="#68DEC5"/></Grid>
     <TextBlock Text="{Binding LiveTotalError}" FontSize="46" FontWeight="Light" Margin="0,0,0,5">
      <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="#EAF0F8"/><Style.Triggers><DataTrigger Binding="{Binding IsMeasurementStale}" Value="True"><Setter Property="Foreground" Value="#6F8199"/></DataTrigger><DataTrigger Binding="{Binding IsWithinTarget}" Value="True"><Setter Property="Foreground" Value="#68DEC5"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
     </TextBlock>
     <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Border Background="#152339" CornerRadius="8" Padding="11" Margin="0,0,5,0"><StackPanel><TextBlock Text="↕  고도" Style="{StaticResource Caption}"/><TextBlock Text="{Binding AltitudeValue}" FontSize="21" Margin="0,5,0,4"/><TextBlock Text="{Binding AltitudeAction}" FontSize="11" Foreground="#AEBFD4"/></StackPanel></Border>
      <Border Grid.Column="1" Background="#152339" CornerRadius="8" Padding="11" Margin="5,0,0,0"><StackPanel><TextBlock Text="↔  방위각" Style="{StaticResource Caption}"/><TextBlock Text="{Binding AzimuthValue}" FontSize="21" Margin="0,5,0,4"/><TextBlock Text="{Binding AzimuthAction}" FontSize="11" Foreground="#AEBFD4"/></StackPanel></Border>
     </Grid>
     <TextBlock Text="{Binding FrameFreshness}" Style="{StaticResource Caption}" Margin="0,11,0,0"/>
    </StackPanel>
   </Border>
   <TextBlock Text="{Binding LiveStatus}" Foreground="#9FB0C7" LineHeight="18" Margin="2,12,2,8"/>
   <TextBlock Text="방향 안내는 천구극을 바라보고 선 기준입니다. 경통 끝이 움직이는 방향이며 볼트를 돌리는 방향은 아닙니다." Style="{StaticResource Caption}" Margin="2,0,2,14"/>

   <Expander Foreground="#B4C4D9" IsExpanded="False" Margin="0,0,0,10">
    <Expander.Header><TextBlock Text="장비 없이 흐름 연습하기" FontSize="11"/></Expander.Header>
    <StackPanel Margin="0,12,0,0">
     <TextBlock Text="합성 데이터 연습 · 실제 정렬에 사용하지 마세요" Foreground="#F0BA72" Margin="0,0,0,10"/>
     <TextBlock Text="{Binding NextAction}" Margin="0,0,0,10"/>
     <WrapPanel><Button Content="연습 시작" Command="{Binding StartCommand}" Margin="0,0,6,6"/><Button Content="{Binding CaptureLabel}" Command="{Binding CaptureCommand}" Margin="0,0,6,6"/><Button Content="종료" Command="{Binding StopCommand}" Margin="0,0,0,6"/></WrapPanel>
     <Border Background="#142238" CornerRadius="8" Padding="12" Margin="0,6,0,0"><StackPanel><TextBlock Text="{Binding TotalError}" FontSize="26"/><TextBlock Text="고도 조정 연습" Margin="0,10,0,0"/><Slider Minimum="-12" Maximum="12" Value="{Binding AltitudeError}" IsEnabled="{Binding IsAdjusting}" Margin="0,8,0,12" AutomationProperties.Name="합성 고도 오차"/><TextBlock Text="방위각 조정 연습"/><Slider Minimum="-12" Maximum="12" Value="{Binding AzimuthError}" IsEnabled="{Binding IsAdjusting}" Margin="0,8,0,0" AutomationProperties.Name="합성 방위각 오차"/></StackPanel></Border>
    </StackPanel>
   </Expander>
   <TextBlock Text="실제 장비 정확도는 검증 전입니다 · 대기 굴절 보정 미적용" Foreground="#667B95" FontSize="10"/>
   </StackPanel>
  </ScrollViewer>
 </Grid>
</UserControl>
