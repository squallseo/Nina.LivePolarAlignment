<UserControl x:Class="Nina.LivePolarAlignment.UI.PolarAlignmentView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:ns="clr-namespace:NINA.Core.Locale;assembly=NINA.Core"
 xmlns:local="clr-namespace:Nina.LivePolarAlignment.UI"
 MinWidth="320" Background="{DynamicResource BackgroundBrush}" Foreground="{DynamicResource PrimaryBrush}">
 <UserControl.Resources>
      <Style x:Key="AlignmentQualityText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Style.Triggers>
          <DataTrigger Binding="{Binding AlignmentQualityLevel}" Value="Within"><Setter Property="Foreground" Value="#43C98F"/></DataTrigger>
          <DataTrigger Binding="{Binding AlignmentQualityLevel}" Value="Close"><Setter Property="Foreground" Value="#E9B85C"/></DataTrigger>
          <DataTrigger Binding="{Binding AlignmentQualityLevel}" Value="Adjust"><Setter Property="Foreground" Value="#F07474"/></DataTrigger>
        </Style.Triggers>
      </Style>
      <DataTemplate x:Key="RotationDirectionIcon">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Viewbox Width="20" Height="20" Margin="0,0,4,0">
            <Canvas Width="24" Height="24" RenderTransformOrigin="0.5,0.5">
              <Canvas.Style><Style TargetType="Canvas"><Style.Triggers><DataTrigger Binding="{Binding}" Value="True"><Setter Property="RenderTransform"><Setter.Value><ScaleTransform ScaleX="-1"/></Setter.Value></Setter></DataTrigger></Style.Triggers></Style></Canvas.Style>
              <Path Data="M 12,20 A 8,8 0 1 1 20,12" Stroke="{DynamicResource PrimaryBrush}" StrokeThickness="1.8" StrokeStartLineCap="Round"/>
              <Path Data="M 16,10 L 20,16 L 24,10 Z" Fill="{DynamicResource PrimaryBrush}"/>
            </Canvas>
          </Viewbox>
          <TextBlock VerticalAlignment="Center" Foreground="{DynamicResource PrimaryBrush}"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Text" Value="E →"/><Style.Triggers><DataTrigger Binding="{Binding}" Value="True"><Setter Property="Text" Value="← W"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
        </StackPanel>
      </DataTemplate>

      <Style x:Key="AlignmentButton" TargetType="Button">
        <Setter Property="MinHeight" Value="28"/>
        <Setter Property="Padding" Value="9,3"/>
        <Setter Property="Background" Value="{DynamicResource BackgroundBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template"><Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="ButtonSurface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="2" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" TextElement.Foreground="{TemplateBinding Foreground}"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource ButtonBackgroundSelectedBrush}"/><Setter Property="Foreground" Value="{DynamicResource ButtonForegroundBrush}"/></Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="ButtonSurface" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/><Setter TargetName="ButtonSurface" Property="BorderThickness" Value="2"/></Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="ButtonSurface" Property="Opacity" Value="0.8"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="ButtonSurface" Property="Opacity" Value="0.4"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value></Setter>
      </Style>
      <Style x:Key="PrimaryAlignmentButton" TargetType="Button" BasedOn="{StaticResource AlignmentButton}">
        <Setter Property="MinHeight" Value="38"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Background" Value="{DynamicResource ButtonBackgroundBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource ButtonForegroundBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
      </Style>
      <Style x:Key="AlignmentSwitch" TargetType="ToggleButton">
        <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="ToggleButton">
              <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}" VerticalAlignment="Center" Margin="0,0,6,0" />
                <Border x:Name="Track" Width="30" Height="16" CornerRadius="8" Background="{DynamicResource ButtonBackgroundBrush}" BorderBrush="{DynamicResource SecondaryBrush}" BorderThickness="1">
                  <Ellipse x:Name="Thumb" Width="10" Height="10" Fill="{DynamicResource PrimaryBrush}" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="2,0" />
                </Border>
              </StackPanel>
              <ControlTemplate.Triggers>
                <Trigger Property="IsChecked" Value="True">
                  <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right" />
                  <Setter TargetName="Track" Property="Background" Value="{DynamicResource SecondaryBrush}" />
                  <Setter TargetName="Thumb" Property="Fill" Value="{DynamicResource BackgroundBrush}" />
                </Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True">
                  <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                  <Setter Property="Opacity" Value="0.4" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style TargetType="TextBox">
        <Setter Property="Background" Value="{DynamicResource BackgroundBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="MinHeight" Value="28" />
        <Setter Property="CaretBrush" Value="{DynamicResource PrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
        <Setter Property="Padding" Value="6,3" />
      </Style>

      <local:SupportingTextColorConverter x:Key="SupportingTextColor"/>
      <SolidColorBrush x:Key="SupportingTextBrush"><SolidColorBrush.Color><MultiBinding Converter="{StaticResource SupportingTextColor}"><Binding Path="Color" Source="{StaticResource PrimaryBrush}"/><Binding Path="Color" Source="{StaticResource BackgroundBrush}"/></MultiBinding></SolidColorBrush.Color></SolidColorBrush>
      <Style TargetType="TextBlock" BasedOn="{StaticResource StandardTextBlock}">
        <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
      </Style>
      <Style x:Key="InputLabel" TargetType="TextBlock" BasedOn="{StaticResource StandardTextBlock}">
        <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
      </Style>
      <Style x:Key="SectionHeading" TargetType="TextBlock" BasedOn="{StaticResource InputLabel}">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
      </Style>
      <Style x:Key="Caption" TargetType="TextBlock" BasedOn="{StaticResource StandardTextBlock}">
        <Setter Property="Foreground" Value="{DynamicResource SupportingTextBrush}"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
      </Style>
      <Style x:Key="ResultLabel" TargetType="TextBlock" BasedOn="{StaticResource Caption}">
        <Setter Property="FontWeight" Value="SemiBold"/>
      </Style>
      <DataTemplate x:Key="SectionHeaderTemplate"><TextBlock Text="{Binding}" Style="{StaticResource SectionHeading}"/></DataTemplate>
      <BooleanToVisibilityConverter x:Key="VisibleIf"/>
 </UserControl.Resources>
 <Grid x:Name="WorkspaceGrid" Margin="4">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition x:Name="ImageRow" Height="*"/><RowDefinition x:Name="NarrowControlsRow" Height="0"/></Grid.RowDefinitions>
  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition x:Name="DividerColumn" Width="6"/><ColumnDefinition x:Name="ControlsColumn" Width="290" MinWidth="270" MaxWidth="480"/></Grid.ColumnDefinitions>
  <Border x:Name="ImagePanel" Grid.Row="1" Grid.Column="0" Background="{DynamicResource BackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="1" Padding="5">
   <DockPanel LastChildFill="True">
    <Grid DockPanel.Dock="Top" Margin="3,0,3,8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{ns:Loc LblImage}" Foreground="{DynamicResource PrimaryBrush}" FontWeight="SemiBold"/><StackPanel Grid.Column="1" Orientation="Horizontal"><TextBlock Text="{local:UiLoc Focus}" VerticalAlignment="Center" Margin="0,0,6,0"/><ToggleButton Style="{StaticResource AlignmentSwitch}" ToolTip="{local:UiLoc FocusTip}" IsChecked="{Binding FocusAlignment, ElementName=SkyField}"/></StackPanel></Grid>
    <Grid>
     <local:PolarFieldView IsSolving="{Binding IsSolvingFrame}" x:Name="SkyField" IsDriftView="{Binding IndependentDriftEnabled}" Preview="{Binding LivePreview}" Guidance="{Binding FieldGuidance}" IsCurrent="{Binding HasCurrentFieldGuidance}" PixelScale="{Binding PixelScaleArcseconds}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
     <StackPanel x:Name="EmptyImagePlaceholder" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
      <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding HasPreview}" Value="False"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></StackPanel.Style>
      <Path Data="{DynamicResource PictureSVG}" Width="100" Height="100" Margin="5" Stretch="Uniform" Fill="{DynamicResource ButtonForegroundDisabledBrush}" Opacity="0.4" UseLayoutRounding="True"/>
      <TextBlock Text="{ns:Loc LblNoImage}" HorizontalAlignment="Center" Foreground="{DynamicResource ButtonForegroundDisabledBrush}" Margin="0,8,0,0"/>
     </StackPanel>
    </Grid>
   </DockPanel>
  </Border>
  <GridSplitter x:Name="PanelDivider" Grid.Row="1" Grid.Column="1" Width="5" HorizontalAlignment="Center" VerticalAlignment="Stretch" Background="{DynamicResource BorderBrush}" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" ShowsPreview="True" ToolTip="{local:UiLoc View0}"/>
  <ScrollViewer x:Name="ControlScroll" Grid.Row="1" Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
   <StackPanel Margin="0,0,2,0">

   <StackPanel Margin="0,0,0,8" Visibility="{Binding IsPolarView, Converter={StaticResource VisibleIf}}">
    <Grid ToolTip="{Binding RotationStatus}" ToolTipService.ShowOnDisabled="True"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <TextBlock x:Name="AutoRaOptionLabel" Text="{local:UiLoc AutoRaOption}" VerticalAlignment="Center" Style="{StaticResource InputLabel}"/>
     <StackPanel x:Name="MountConnectionHint" Grid.Column="1" Orientation="Horizontal" Margin="6,0" VerticalAlignment="Center" Visibility="{Binding MountDisconnected, Converter={StaticResource VisibleIf}}">
      <TextBlock Text="{Binding NotConnectedText}" FontSize="11" VerticalAlignment="Center" Margin="0,0,4,0"/>
      <CheckBox Width="14" Height="14" BorderBrush="Transparent" IsChecked="False" IsEnabled="False" IsHitTestVisible="False" Style="{StaticResource CheckmarkCheckbox}"/>
     </StackPanel>
     <ToggleButton x:Name="AutoRaToggle" Grid.Column="2" Style="{StaticResource AlignmentSwitch}" IsChecked="{Binding AutoRaRotation}" IsEnabled="{Binding CanConfigureRotation}"/>
    </Grid>
    <StackPanel x:Name="RotationSettingsPanel" Visibility="{Binding AutoRaRotation, Converter={StaticResource VisibleIf}}" IsEnabled="{Binding CanConfigureAutoRotation}">
     <DockPanel Margin="0,5,0,0"><StackPanel DockPanel.Dock="Right" Orientation="Horizontal" IsEnabled="{Binding CanConfigureRotation}"><Button Content="−" Width="26" Padding="0" Style="{StaticResource AlignmentButton}" Command="{Binding DecreaseRotationAngleCommand}"/><TextBox Width="42" Margin="3,0" TextAlignment="Center" Padding="2,3" Text="{Binding RotationAngleDegrees, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"/><Button Content="+" Width="26" Padding="0" Style="{StaticResource AlignmentButton}" Command="{Binding IncreaseRotationAngleCommand}"/></StackPanel><TextBlock Text="{local:UiLoc AutoRaAngle}" VerticalAlignment="Center" Style="{StaticResource InputLabel}"/></DockPanel>

     <DockPanel Margin="0,4,0,0"><ToggleButton DockPanel.Dock="Right" Style="{StaticResource AlignmentSwitch}" IsChecked="{Binding ReverseRaRotation}" IsEnabled="{Binding CanConfigureRotation}"/><ContentControl DockPanel.Dock="Right" Margin="6,0,6,0" VerticalAlignment="Center" Content="{Binding ReverseRaRotation}" ContentTemplate="{StaticResource RotationDirectionIcon}" ToolTip="{local:UiLoc RotationDirectionHint}"/><TextBlock Text="{local:UiLoc AutoRaReverse}" VerticalAlignment="Center" Style="{StaticResource InputLabel}"/></DockPanel>

    </StackPanel>
   </StackPanel>
   <StackPanel Margin="0,0,0,8" Visibility="{Binding IsPolarView, Converter={StaticResource VisibleIf}}" ToolTip="{Binding StreamingAvailability}" ToolTipService.ShowOnDisabled="True">
    <DockPanel><TextBlock Text="{local:UiLoc StreamingOption}" VerticalAlignment="Center" Style="{StaticResource InputLabel}"/><ToggleButton Style="{StaticResource AlignmentSwitch}" DockPanel.Dock="Right" HorizontalAlignment="Right" IsChecked="{Binding UseStreaming}" IsEnabled="{Binding CanUseStreaming}" ToolTip="{Binding StreamingAvailability}"/></DockPanel>
   </StackPanel>
   <Grid Margin="0,0,0,13">
    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <TextBlock x:Name="ExposureLabel" Text="{ns:Loc LblExposureTime}" VerticalAlignment="Center" Margin="0,0,8,0" Style="{StaticResource InputLabel}"/>
    <TextBox Grid.Column="1" Width="60" Text="{Binding ExposureSeconds, UpdateSourceTrigger=LostFocus}" IsEnabled="{Binding CanConfigureLive}" AutomationProperties.Name="{local:UiLoc View7}"/>
    <TextBlock Grid.Column="2" Text="{local:UiLoc View8}" VerticalAlignment="Center" Foreground="{DynamicResource PrimaryBrush}" Margin="7,0,0,0"/>
   </Grid>

   <Grid Margin="0,0,0,10">
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <Grid Margin="0,0,6,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <Button x:Name="PrimaryActionButton" Style="{StaticResource PrimaryAlignmentButton}" Command="{Binding ActionButtonCommand}" ToolTip="{Binding ActionButtonHint}" ToolTipService.ShowOnDisabled="True" AutomationProperties.Name="{Binding ActionButtonLabel}">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
       <Path x:Name="PrimaryActionIcon" Width="16" Height="16" Margin="0,0,8,0" Stretch="Uniform" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"><Path.Style><Style TargetType="Path"><Setter Property="Data" Value="{DynamicResource PlaySVG}"/><Style.Triggers><DataTrigger Binding="{Binding IsWorking}" Value="True"><Setter Property="Data" Value="{DynamicResource StopSVG}"/></DataTrigger></Style.Triggers></Style></Path.Style></Path>
       <TextBlock x:Name="PrimaryActionText" FontWeight="{Binding FontWeight, RelativeSource={RelativeSource AncestorType=Button}}" Text="{Binding ActionButtonLabel}" VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
      </StackPanel>
     </Button>
     <StackPanel x:Name="CameraConnectionHint" Grid.Column="1" Orientation="Horizontal" Margin="5,0,0,0" VerticalAlignment="Center" ToolTip="{Binding CameraConnectionHint}" Visibility="{Binding CameraDisconnected, Converter={StaticResource VisibleIf}}">
      <TextBlock Text="{Binding NotConnectedText}" FontSize="11" VerticalAlignment="Center" Margin="0,0,4,0"/>
      <CheckBox Width="14" Height="14" BorderBrush="Transparent" IsChecked="False" IsEnabled="False" IsHitTestVisible="False" Style="{StaticResource CheckmarkCheckbox}"/>
     </StackPanel>
    </Grid>
    <Button x:Name="ResetActionButton" Style="{StaticResource AlignmentButton}" Grid.Column="1" Width="38" MinHeight="38" Padding="8" ToolTip="{local:UiLoc View6}" Command="{Binding ResetLiveCommand}" AutomationProperties.Name="{local:UiLoc View5}">
     <Path Data="{DynamicResource RefreshSVG}" Width="16" Height="16" Stretch="Uniform" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
    </Button>
   </Grid>
   <Border Background="{DynamicResource BackgroundBrush}" BorderBrush="{DynamicResource NotificationErrorTextBrush}" BorderThickness="1" CornerRadius="1" Padding="5" Margin="0,0,0,12" Visibility="{Binding HasOperationError, Converter={StaticResource VisibleIf}}"><StackPanel><TextBlock Text="{local:UiLoc View9}" Foreground="{DynamicResource PrimaryBrush}" FontWeight="SemiBold"/><TextBlock Text="{Binding OperationError}" Foreground="{DynamicResource PrimaryBrush}" Margin="0,5,0,0"/></StackPanel></Border>

   <Border Background="{DynamicResource BackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="1" Padding="5" Visibility="{Binding IsPolarView, Converter={StaticResource VisibleIf}}">
    <StackPanel>
     <DockPanel Margin="0,0,0,6"><TextBox DockPanel.Dock="Right" Width="48" Text="{Binding ValidationTargetArcseconds, UpdateSourceTrigger=LostFocus}" IsEnabled="{Binding CanConfigureAlignmentTarget}" AutomationProperties.Name="{local:UiLoc PolarTarget}"/><TextBlock Text="{local:UiLoc PolarTarget}" VerticalAlignment="Center" Margin="0,0,6,0" Style="{StaticResource InputLabel}"/></DockPanel>
     <TextBlock x:Name="PolarErrorHeading" Text="{local:UiLoc View10}" Style="{StaticResource SectionHeading}"/>
     <TextBlock Text="{Binding LiveTotalError}" Style="{StaticResource AlignmentQualityText}" FontSize="26" FontWeight="SemiBold" Margin="0,0,0,5"/>
     <TextBlock x:Name="AlignmentQualityIndicator" Text="{Binding AlignmentQualityText}" Style="{StaticResource AlignmentQualityText}" FontWeight="SemiBold" Margin="0,0,0,8"/>
     <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Border Background="{DynamicResource BackgroundBrush}" CornerRadius="1" Padding="5" Margin="0,0,5,0"><StackPanel><TextBlock Text="{ns:Loc LblAltitude}" Style="{StaticResource ResultLabel}"/><TextBlock Text="{Binding AltitudeValue}" FontSize="18" Margin="0,5,0,4"/><TextBlock Text="{Binding AltitudeAction}" Style="{StaticResource Caption}" ToolTip="{local:UiLoc View11}"/></StackPanel></Border>
      <Border Grid.Column="1" Background="{DynamicResource BackgroundBrush}" CornerRadius="1" Padding="5" Margin="5,0,0,0"><StackPanel><TextBlock Text="{ns:Loc LblAzimuth}" Style="{StaticResource ResultLabel}"/><TextBlock Text="{Binding AzimuthValue}" FontSize="18" Margin="0,5,0,4"/><TextBlock Text="{Binding AzimuthAction}" Style="{StaticResource Caption}" ToolTip="{local:UiLoc View11}"/></StackPanel></Border>
     </Grid>
     <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Margin="0,8,0,0" Padding="0,7,0,0">
      <StackPanel ToolTip="{local:UiLoc ImpactHint}">
       <TextBlock x:Name="ImpactSectionTitle" Text="{local:UiLoc ImpactTitle}" Style="{StaticResource SectionHeading}"/>
       <TextBlock Text="{Binding EstimatedUnguidedDrift}" FontWeight="SemiBold" Margin="0,3,0,3"/>
       <DockPanel><TextBox DockPanel.Dock="Right" Width="48" Text="{Binding ScienceExposureSeconds, UpdateSourceTrigger=LostFocus}" AutomationProperties.Name="{local:UiLoc ScienceExposure}"/><TextBlock Text="{local:UiLoc ScienceExposure}" VerticalAlignment="Center" Margin="0,0,6,0" Style="{StaticResource InputLabel}"/></DockPanel>
       <TextBlock Text="{Binding EstimatedExposureMotion}" FontWeight="SemiBold" Margin="0,4,0,3"/>
       <TextBlock x:Name="ImpactExplanation" Text="{local:UiLoc ImpactCaveat}" Style="{StaticResource Caption}"/>
      </StackPanel>
     </Border>
     <StackPanel x:Name="AlignmentDetailPanel" Visibility="{Binding HasAlignmentDetail, Converter={StaticResource VisibleIf}}" Margin="0,8,0,0">
      <TextBlock Text="{local:UiLoc AlignmentCloseUp}" Margin="0,0,0,4" Style="{StaticResource SectionHeading}"/>
      <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="5" ClipToBounds="True">
       <local:PolarFieldView x:Name="AlignmentDetailView" Height="186" DetailMode="True" ReferenceScale="{Binding ImageScale, ElementName=SkyField}" Preview="{Binding LivePreview}" Guidance="{Binding FieldGuidance}" IsCurrent="{Binding HasCurrentFieldGuidance}" PixelScale="{Binding PixelScaleArcseconds}"/>
      </Border>
     </StackPanel>
     <TextBlock Text="{Binding FrameFreshness}" Style="{StaticResource Caption}" Margin="0,11,0,0"/>
    </StackPanel>
   </Border>

   <Expander HeaderTemplate="{StaticResource SectionHeaderTemplate}" x:Name="VerificationTools" Header="{local:UiLoc VerificationTitle}" Foreground="{DynamicResource PrimaryBrush}" Margin="0,6,0,0" Visibility="{Binding ShowVerification, Converter={StaticResource VisibleIf}}">
    <StackPanel Margin="2,6,2,0">
     <TextBlock Text="{Binding VerificationSummary}" Style="{StaticResource Caption}"/>
     <DockPanel Margin="0,5,0,0"><StackPanel DockPanel.Dock="Right" Orientation="Horizontal" IsEnabled="{Binding CanConfigureVerification}"><Button Content="−" Width="26" Padding="0" Style="{StaticResource AlignmentButton}" Command="{Binding DecreaseRotationAngleCommand}"/><TextBox Width="42" Margin="3,0" TextAlignment="Center" Padding="2,3" Text="{Binding RotationAngleDegrees, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"/><Button Content="+" Width="26" Padding="0" Style="{StaticResource AlignmentButton}" Command="{Binding IncreaseRotationAngleCommand}"/></StackPanel><TextBlock Text="{local:UiLoc AutoRaAngle}" VerticalAlignment="Center" Style="{StaticResource InputLabel}"/></DockPanel>
     <DockPanel Margin="0,5,0,0"><ToggleButton DockPanel.Dock="Right" Style="{StaticResource AlignmentSwitch}" IsChecked="{Binding VerificationReverse}" IsEnabled="{Binding CanConfigureVerification}"/><ContentControl DockPanel.Dock="Right" Margin="6,0,6,0" VerticalAlignment="Center" Content="{Binding VerificationReverse}" ContentTemplate="{StaticResource RotationDirectionIcon}" ToolTip="{local:UiLoc RotationDirectionHint}"/><TextBlock Text="{local:UiLoc AutoRaReverse}" Style="{StaticResource InputLabel}"/></DockPanel>
     <DockPanel Margin="0,5,0,0"><ToggleButton DockPanel.Dock="Right" Style="{StaticResource AlignmentSwitch}" IsChecked="{Binding AutoVerificationStability}" IsEnabled="{Binding CanConfigureVerification}"/><TextBlock Text="{local:UiLoc VerificationStability}" Style="{StaticResource InputLabel}"/></DockPanel>
     <Button Content="{local:UiLoc VerificationStart}" Command="{Binding VerifyAlignmentCommand}" Style="{StaticResource AlignmentButton}" Margin="0,7,0,0" ToolTip="{local:UiLoc VerificationHint}"/>
     <TextBlock Text="{Binding StabilityStatus}" Style="{StaticResource Caption}" Margin="0,5,0,0"/>
    </StackPanel>
   </Expander>
   <Expander HeaderTemplate="{StaticResource SectionHeaderTemplate}" x:Name="IndependentDriftTools" Header="{local:UiLoc DriftTitle}" Foreground="{DynamicResource PrimaryBrush}" Margin="0,6,0,0">
    <StackPanel Margin="2,6,2,0">
     <DockPanel><ToggleButton DockPanel.Dock="Right" Style="{StaticResource AlignmentSwitch}" IsChecked="{Binding IndependentDriftEnabled}" IsEnabled="{Binding CanConfigureDrift}"/><TextBlock Text="{local:UiLoc DriftEnable}" Style="{StaticResource InputLabel}"/></DockPanel>
     <StackPanel Visibility="{Binding IndependentDriftEnabled, Converter={StaticResource VisibleIf}}">
      <DockPanel Margin="0,5,0,0"><TextBlock Text="{local:UiLoc DriftDuration}" Style="{StaticResource InputLabel}"/><TextBox Width="50" Text="{Binding DriftDurationSeconds, UpdateSourceTrigger=LostFocus}" IsEnabled="{Binding CanConfigureDrift}" Margin="5,0,0,0"/></DockPanel>

      <DockPanel Margin="0,5,0,0"><ToggleButton DockPanel.Dock="Right" Style="{StaticResource AlignmentSwitch}" IsChecked="{Binding DriftConfirmed}" IsEnabled="{Binding CanConfigureDrift}"/><TextBlock Text="{local:UiLoc DriftConfirm}" Style="{StaticResource InputLabel}"/></DockPanel>
      <Button Content="{Binding DriftActionLabel}" Command="{Binding IndependentDriftCommand}" Style="{StaticResource AlignmentButton}" Margin="0,6,0,0"/>
      <Button Content="{local:UiLoc DriftReset}" Command="{Binding ResetIndependentDriftCommand}" Style="{StaticResource AlignmentButton}" Margin="0,4,0,0"/>
      <TextBlock Text="{Binding IndependentDriftStatus}" Style="{StaticResource Caption}" Margin="0,6,0,0"/>
     </StackPanel>
    </StackPanel>
   </Expander>
   <Border Background="{DynamicResource BackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="5" Margin="0,7,0,0" Visibility="{Binding ShowAlignmentAssessment, Converter={StaticResource VisibleIf}}">
    <StackPanel>
     <DockPanel><TextBlock Text="{local:UiLoc ValidationTarget}" Style="{StaticResource InputLabel}"/><TextBox Width="45" Text="{Binding ValidationTargetArcseconds, UpdateSourceTrigger=LostFocus}" IsEnabled="{Binding CanConfigureDrift}" Margin="5,0,0,0"/></DockPanel>
     <TextBlock Text="{Binding AlignmentAssessmentText}" TextWrapping="Wrap" Margin="0,5,0,0"><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource Caption}"><Setter Property="Foreground" Value="{DynamicResource SupportingTextBrush}"/><Style.Triggers><DataTrigger Binding="{Binding HasValidationWarning}" Value="True"><Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}"/><Setter Property="FontWeight" Value="SemiBold"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
    </StackPanel>
   </Border>
   <Expander HeaderTemplate="{StaticResource SectionHeaderTemplate}" x:Name="FieldValidationTools" Header="{local:UiLoc FieldValidation}" Foreground="{DynamicResource PrimaryBrush}" Margin="0,6,0,0">
    <StackPanel Margin="2,6,2,0">
     <DockPanel><TextBlock Text="{local:UiLoc FieldRecord}" VerticalAlignment="Center" Style="{StaticResource InputLabel}"/><ToggleButton Style="{StaticResource AlignmentSwitch}" HorizontalAlignment="Right" IsChecked="{Binding RecordFieldSession}" IsEnabled="{Binding CanConfigureField}" ToolTip="{local:UiLoc FieldRecordHint}"/></DockPanel>
     <TextBox Text="{Binding FieldNote, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{local:UiLoc FieldNotes}" ToolTip="{local:UiLoc FieldNotesHint}" Margin="0,6,0,4"/>
     <WrapPanel><Button Content="{local:UiLoc FieldMark}" Command="{Binding MarkFieldSampleCommand}" Style="{StaticResource AlignmentButton}" Margin="0,0,4,0" ToolTip="{local:UiLoc FieldMarkHint}"/><Button Content="{local:UiLoc FieldStability}" Command="{Binding CheckStabilityCommand}" Style="{StaticResource AlignmentButton}" Margin="0,0,4,0"/><Button Content="{local:UiLoc FieldFolder}" Command="{Binding OpenFieldFolderCommand}" Style="{StaticResource AlignmentButton}"/></WrapPanel>
     <TextBlock Text="{Binding StabilityStatus}" Style="{StaticResource Caption}" Margin="0,5,0,0"/>
    </StackPanel>
   </Expander>
   <TextBlock Text="{Binding FieldRecordingStatus}" Margin="2,4,2,0" ToolTip="{Binding FieldSessionDirectory}"><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource Caption}"><Style.Triggers><DataTrigger Binding="{Binding HasFieldFailure}" Value="True"><Setter Property="Foreground" Value="{DynamicResource NotificationWarningTextBrush}"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
</StackPanel></ScrollViewer></Grid></UserControl>
