<ResourceDictionary x:Class="Nina.LivePolarAlignment.UI.PolarAlignmentTemplates"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="clr-namespace:Nina.LivePolarAlignment.UI">
 <!-- Monochrome filled geometry inherits NINA's active tab/theme brush. -->
 <GeometryGroup x:Key="Nina.LivePolarAlignment.PolarAxisIcon">
  <!-- RA orbit, open toward the pole star. -->
  <PathGeometry Figures="M14 4 A12 12 0 1 0 26 16 L23.5 16 A9.5 9.5 0 1 1 14 6.5 Z"/>
  <!-- Axis target: a clear central aperture with four short crosshair ticks. -->
  <PathGeometry FillRule="EvenOdd" Figures="M19 16 A5 5 0 1 1 9 16 A5 5 0 1 1 19 16 Z M16.5 16 A2.5 2.5 0 1 0 11.5 16 A2.5 2.5 0 1 0 16.5 16 Z"/>
  <PathGeometry Figures="M13 8 L15 8 L15 12 L13 12 Z M13 20 L15 20 L15 24 L13 24 Z M6 15 L10 15 L10 17 L6 17 Z M18 15 L22 15 L22 17 L18 17 Z"/>
  <!-- Celestial pole / guide star. -->
  <PathGeometry Figures="M24 0 L25.8 5.2 L31 7 L25.8 8.8 L24 14 L22.2 8.8 L17 7 L22.2 5.2 Z"/>
 </GeometryGroup>
 <DataTemplate x:Key="Nina.LivePolarAlignment.UI.PolarAlignmentDockableVM_Dockable">
  <local:PolarAlignmentView/>
 </DataTemplate>
 <DataTemplate x:Key="Live Polar Alignment_Options">
  <StackPanel Margin="12" MaxWidth="420">
   <TextBlock Text="{local:UiLoc DebugTitle}" FontWeight="Bold" Margin="0,0,0,8"/>
   <CheckBox Content="{local:UiLoc DebugEnable}" IsChecked="{Binding EnableDebugRecording, Mode=TwoWay}" Margin="0,0,0,8"/>
   <TextBlock Text="{local:UiLoc DebugHelp}" TextWrapping="Wrap" Foreground="{DynamicResource SecondaryBrush}" FontSize="11"/>
  </StackPanel>
 </DataTemplate>
</ResourceDictionary>
