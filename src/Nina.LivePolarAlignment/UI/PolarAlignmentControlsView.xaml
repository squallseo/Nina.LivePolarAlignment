<UserControl x:Class="Nina.LivePolarAlignment.UI.PolarAlignmentControlsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ns="clr-namespace:NINA.Core.Locale;assembly=NINA.Core" xmlns:local="clr-namespace:Nina.LivePolarAlignment.UI" MinWidth="250" Background="{DynamicResource BackgroundBrush}" Foreground="{DynamicResource PrimaryBrush}">
<UserControl.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="/Nina.LivePolarAlignment;component/UI/PolarAlignmentStyles.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary></UserControl.Resources>
 <ScrollViewer x:Name="ControlScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
   <StackPanel Margin="3,3,5,3">
   <StackPanel Margin="0,0,0,8" Visibility="{Binding IsPolarView, Converter={StaticResource VisibleIf}}">
    <TextBlock Text="{local:UiLoc AlignmentMethod}" Style="{StaticResource InputLabel}" Margin="0,0,0,4"/>
    <ComboBox x:Name="AlignmentMethodSelector" SelectedIndex="{Binding AlignmentMethodIndex, Mode=TwoWay}" IsEnabled="{Binding CanConfigurePoleMaster}">
     <ComboBoxItem Content="{local:UiLoc MethodPoleMaster}"/>
     <ComboBoxItem Content="{local:UiLoc MethodNinaSolver}"/>
    </ComboBox>
   </StackPanel>
   <Grid Margin="0,0,0,10">
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <Grid Margin="0,0,6,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <Button x:Name="PrimaryActionButton" Style="{StaticResource PrimaryAlignmentButton}" Command="{Binding ActionButtonCommand}" ToolTip="{Binding ActionButtonHint}" ToolTipService.ShowOnDisabled="True" AutomationProperties.Name="{Binding ActionButtonLabel}">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
       <Path x:Name="PrimaryActionIcon" Width="16" Height="16" Margin="0,0,8,0" Stretch="Uniform" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"><Path.Style><Style TargetType="Path"><Setter Property="Data" Value="{DynamicResource PlaySVG}"/><Style.Triggers><DataTrigger Binding="{Binding IsWorking}" Value="True"><Setter Property="Data" Value="{DynamicResource StopSVG}"/></DataTrigger></Style.Triggers></Style></Path.Style></Path>
       <TextBlock x:Name="PrimaryActionText" FontWeight="{Binding FontWeight, RelativeSource={RelativeSource AncestorType=Button}}" Text="{Binding ActionButtonLabel}" VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
      </StackPanel>
     </Button>
     <StackPanel x:Name="CameraConnectionHint" Grid.Column="1" Orientation="Horizontal" Margin="5,0,0,0" VerticalAlignment="Center" ToolTip="{Binding CameraConnectionHint}" Visibility="{Binding CameraDisconnected, Converter={StaticResource VisibleIf}}">
      <TextBlock Text="{Binding NotConnectedText}" FontSize="11" VerticalAlignment="Center" Margin="0,0,4,0"/>
      <CheckBox Width="14" Height="14" BorderBrush="Transparent" IsChecked="False" IsEnabled="False" IsHitTestVisible="False" Style="{StaticResource CheckmarkCheckbox}"/>
     </StackPanel>
    </Grid>
    <Button x:Name="ResetActionButton" Visibility="{Binding ShowLegacyReset, Converter={StaticResource VisibleIf}}" Style="{StaticResource AlignmentButton}" Grid.Column="1" Width="38" MinHeight="38" Padding="8" ToolTip="{local:UiLoc View6}" Command="{Binding ResetLiveCommand}" AutomationProperties.Name="{local:UiLoc View5}">
     <Path Data="{DynamicResource RefreshSVG}" Width="16" Height="16" Stretch="Uniform" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
    </Button>
   </Grid>




   <Border BorderBrush="#E9B85C" BorderThickness="1" Padding="6" Margin="0,0,0,8" Visibility="{Binding HasMethodWarning, Converter={StaticResource VisibleIf}}"><TextBlock Text="{Binding MethodCompatibilityWarning}" TextWrapping="Wrap" FontSize="12"/></Border>
   <Grid Margin="0,0,0,9">
    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <ItemsControl x:Name="WorkflowStages" ItemsSource="{Binding WorkflowStages}" Visibility="{Binding IsPolarView, Converter={StaticResource VisibleIf}}" Width="98" Margin="0,0,6,0" VerticalAlignment="Top" AutomationProperties.Name="{local:UiLoc ProgressSteps}">
     <ItemsControl.ItemTemplate><DataTemplate>
      <Border CornerRadius="3" Padding="4,5" Margin="0,0,0,2" IsEnabled="{Binding IsCurrent}">
       <Border.Style><Style TargetType="Border"><Setter Property="Opacity" Value="0.4"/><Setter Property="Background" Value="Transparent"/><Style.Triggers>
        <DataTrigger Binding="{Binding IsCompleted}" Value="True"><Setter Property="Opacity" Value="0.65"/></DataTrigger>
        <DataTrigger Binding="{Binding IsCurrent}" Value="True"><Setter Property="Opacity" Value="1"/><Setter Property="Background" Value="#3043C98F"/></DataTrigger>
       </Style.Triggers></Style></Border.Style>
       <DockPanel><TextBlock Text="{Binding Marker}" Width="19" FontWeight="SemiBold" Foreground="#43C98F"/><TextBlock Text="{Binding Label}" FontSize="11" TextWrapping="Wrap"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="FontWeight" Value="Normal"/><Style.Triggers><DataTrigger Binding="{Binding IsCurrent}" Value="True"><Setter Property="FontWeight" Value="SemiBold"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></DockPanel>
      </Border>
     </DataTemplate></ItemsControl.ItemTemplate>
    </ItemsControl>
   <Border x:Name="OperatorAdviceCard" Grid.Column="1" MinHeight="152" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Background="{DynamicResource BackgroundBrush}" CornerRadius="5" Padding="9">
    <StackPanel>
     <TextBlock Text="{local:UiLoc OperatorStatusLabel}" FontSize="11" Opacity="0.75"/>
     <TextBlock x:Name="OperatorStateTitle" Text="{Binding OperatorStateTitle}" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,3,0,5">
      <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}"/><Style.Triggers>
       <DataTrigger Binding="{Binding OperatorState}" Value="Within"><Setter Property="Foreground" Value="#43C98F"/></DataTrigger>
       <DataTrigger Binding="{Binding OperatorState}" Value="Close"><Setter Property="Foreground" Value="#E9B85C"/></DataTrigger>
       <DataTrigger Binding="{Binding OperatorState}" Value="Adjust"><Setter Property="Foreground" Value="#E9B85C"/></DataTrigger>
       <DataTrigger Binding="{Binding OperatorState}" Value="Far"><Setter Property="Foreground" Value="#E9B85C"/></DataTrigger>
       <DataTrigger Binding="{Binding OperatorState}" Value="Outside"><Setter Property="Foreground" Value="#E9B85C"/></DataTrigger>
       <DataTrigger Binding="{Binding OperatorState}" Value="Stale"><Setter Property="Foreground" Value="#E9B85C"/></DataTrigger>
       <DataTrigger Binding="{Binding OperatorState}" Value="Recalibrate"><Setter Property="Foreground" Value="#E9B85C"/></DataTrigger>
      </Style.Triggers></Style></TextBlock.Style>
     </TextBlock>
     <TextBlock Text="{Binding OperatorNextAction}" FontSize="12" TextWrapping="Wrap" LineHeight="16"/>
     <TextBlock Text="{Binding CameraFieldOfView}" FontSize="11" Opacity="0.7" Margin="0,6,0,0" TextWrapping="Wrap"/>
    </StackPanel>
   </Border>
   </Grid>



   <Button x:Name="PreviewLoopButton" Content="{Binding PreviewLoopLabel}" Command="{Binding TogglePreviewLoopCommand}" Style="{StaticResource AlignmentButton}" Margin="0,0,0,8" HorizontalAlignment="Stretch" Visibility="{Binding ShowPreviewLoop, Converter={StaticResource VisibleIf}}"/>

   <StackPanel Visibility="{Binding PoleMasterMode, Converter={StaticResource VisibleIf}}" Margin="0,0,0,9">
    <Button x:Name="HomeResetButton" Content="{local:UiLoc RestartHomeButton}" ToolTip="{local:UiLoc RestartHomePlan}" Command="{Binding HomeRestartCommand}" Style="{StaticResource AlignmentButton}" Margin="0,0,0,4" Visibility="{Binding ShowOptionalHome, Converter={StaticResource VisibleIf}}"/>
   </StackPanel>
   <Border Background="{DynamicResource BackgroundBrush}" BorderBrush="{DynamicResource NotificationErrorTextBrush}" BorderThickness="1" CornerRadius="1" Padding="5" Margin="0,0,0,12" Visibility="{Binding HasOperationError, Converter={StaticResource VisibleIf}}"><StackPanel><TextBlock Text="{local:UiLoc View9}" Foreground="{DynamicResource PrimaryBrush}" FontWeight="SemiBold"/><TextBlock Text="{Binding FriendlyOperationError}" TextWrapping="Wrap" Foreground="{DynamicResource PrimaryBrush}" Margin="0,5,0,0"/><Expander Header="{local:UiLoc RestartErrorDetails}" Margin="0,5,0,0"><TextBlock Text="{Binding OperationError}" TextWrapping="Wrap" FontSize="11"/></Expander></StackPanel></Border>

   <Border Background="{DynamicResource BackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="1" Padding="5" Visibility="{Binding ShowAlignmentReadout, Converter={StaticResource VisibleIf}}">
    <StackPanel>

     <Button Content="{local:UiLoc StartPoleMasterMonitor}" Command="{Binding StartPoleMasterMonitoringCommand}" Visibility="{Binding ShowPoleMasterMonitoringAction, Converter={StaticResource VisibleIf}}" Style="{StaticResource AlignmentButton}" Margin="0,0,0,8"/>
     <Button Content="{local:UiLoc BackToPolarisTarget}" Command="{Binding ReturnToPolarisTargetCommand}" Visibility="{Binding IsPoleMasterMonitoring, Converter={StaticResource VisibleIf}}" Style="{StaticResource AlignmentButton}" Margin="0,0,0,8"/>
     <StackPanel x:Name="AlignmentDetailPanel" Visibility="{Binding HasAlignmentDetail, Converter={StaticResource VisibleIf}}" Margin="0,8,0,0">
      <TextBlock Text="{local:UiLoc AlignmentCloseUp}" Margin="0,0,0,4" Style="{StaticResource SectionHeading}"/>
      <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="5" ClipToBounds="True">
       <local:PolarFieldView x:Name="AlignmentDetailView" Height="186" DetailMode="True" ReferenceScale="{Binding MainImageScale}" Preview="{Binding LivePreview}" UsePolarisTarget="{Binding UsePolarisTarget}" IsPoleMasterMonitoring="{Binding IsPoleMasterMonitoring}" Guidance="{Binding FieldGuidance}" IsCurrent="{Binding HasDisplayGuidance}" IsGuidanceFresh="{Binding HasCurrentFieldGuidance}" PixelScale="{Binding PixelScaleArcseconds}"/>
      </Border>
     </StackPanel>
     <TextBlock Text="{Binding ManualOffsetReadout}" Visibility="{Binding ShowManualOffset, Converter={StaticResource VisibleIf}}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,5,0,8"/>
     <StackPanel Visibility="{Binding ShowPolarErrorReadout, Converter={StaticResource VisibleIf}}">
     <TextBlock x:Name="PolarErrorHeading" Text="{local:UiLoc View10}" Style="{StaticResource SectionHeading}"/>
     <TextBlock Text="{Binding AdjustmentErrorReadout}" Style="{StaticResource AlignmentQualityText}" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,5"/>

     <TextBlock x:Name="AlignmentQualityIndicator" Text="{Binding AlignmentQualityText}" Style="{StaticResource AlignmentQualityText}" FontWeight="SemiBold" Margin="0,0,0,8"/>
     <Grid>
      <Grid.Style><Style TargetType="Grid"><Style.Triggers><DataTrigger Binding="{Binding IsPoleMasterMonitoring}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Grid.Style>
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Border Background="{DynamicResource BackgroundBrush}" CornerRadius="1" Padding="5" Margin="0,0,5,0"><StackPanel><TextBlock Text="{ns:Loc LblAltitude}" Style="{StaticResource ResultLabel}"/><TextBlock Text="{Binding AltitudeAdjustmentAction}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,5,0,6"/><TextBlock Text="{Binding AltitudeRemaining}" FontSize="12" TextWrapping="Wrap"/></StackPanel></Border>
      <Border Grid.Column="1" Background="{DynamicResource BackgroundBrush}" CornerRadius="1" Padding="5" Margin="5,0,0,0"><StackPanel><TextBlock Text="{ns:Loc LblAzimuth}" Style="{StaticResource ResultLabel}"/><TextBlock Text="{Binding AzimuthAdjustmentAction}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,5,0,6"/><TextBlock Text="{Binding AzimuthRemaining}" FontSize="12" TextWrapping="Wrap"/></StackPanel></Border>
     </Grid>
     </StackPanel>

     <Expander Header="{local:UiLoc RestartErrorDetails}" Margin="0,4,0,0"><StackPanel>
     <TextBlock Text="{Binding FrameFreshness}" Visibility="{Binding ShowPolarErrorReadout, Converter={StaticResource VisibleIf}}" Style="{StaticResource Caption}" Margin="0,11,0,0"/>
     <TextBlock Text="{Binding TrackingReadout}" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"/>
     </StackPanel></Expander>
    </StackPanel>
   </Border>





   <TextBlock Text="{Binding FieldRecordingStatus}" Visibility="{Binding HasFieldFailure, Converter={StaticResource VisibleIf}}" Margin="2,4,2,0" ToolTip="{Binding FieldSessionDirectory}"><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource Caption}"><Style.Triggers><DataTrigger Binding="{Binding HasFieldFailure}" Value="True"><Setter Property="Foreground" Value="{DynamicResource NotificationWarningTextBrush}"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
</StackPanel></ScrollViewer>
</UserControl>
